# 把微调后的模型切换为线上生成模型
# 前提：已执行 `ollama create exam-prep-7b -f training/Modelfile.exam-prep-7b` 且 `ollama list` 能看到该模型
# 说明：ai-service 走 OpenAI 兼容协议，Ollama 的 /v1 即为该协议，无需改代码。

# 追加到 ai-service/.env（同名键以最后一次为准，改完重启 AI 服务）
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=exam-prep-7b
LLM_API_KEY=ollama
LLM_GENERATOR_NAME=exam-prep-7b
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=800

# 回滚：把上面四行删掉或改回
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash
# LLM_API_KEY=<原 GLM Key>
# LLM_GENERATOR_NAME=glm
