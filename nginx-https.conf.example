# ============================================================
# HTTPS 入口模板（可选）
#
# 现状：nginx.conf 只监听 80，全链路为明文 HTTP——这是「上架」的硬性障碍之一。
# 本文件给出切到 TLS 的完整配置；启用步骤：
#
#   1) 准备证书，放到 ./nginx/certs/（fullchain.pem + privkey.pem）
#      - 正式：向 CA 申请（或 Let's Encrypt / acme.sh）
#      - 内网测试：openssl req -x509 -newkey rsa:2048 -nodes -days 365 \
#          -keyout privkey.pem -out fullchain.pem -subj "/CN=你的域名或IP"
#   2) docker-compose.yml 的 nginx 服务增加挂载：
#        - ./nginx/certs:/etc/nginx/certs:ro
#      并把 ./nginx.conf 换成 ./nginx-https.conf.example 的内容
#      （或直接把本文件重命名为 nginx.conf）
#   3) nginx 服务放开 443：ports 增加 "443:443"
#   4) 客户端同步：学生端 BASE_URL 改为 https:// 域名，
#      并把 network_security_config 的 base-config 改为 cleartextTrafficPermitted="false"
#
# ★ 切 TLS 后必须真机回归——学生端/管理端任何遗漏的 http 地址都会连不上。
# ============================================================

# ---------- 80：仅用于跳转 https 与 ACME 校验 ----------
server {
    listen 80;
    server_name _;

    # Let's Encrypt 等证书校验路径需保持明文可达
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------- 443：TLS 入口 ----------
server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    # HSTS：告知浏览器后续强制走 https（确认长期启用后再加 preload）
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    client_max_body_size 210m;   # 覆盖文档上传 200MB 限制

    location / {
        proxy_pass http://backend:8080;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        # 让后端知道原始协议是 https（若有重定向/绝对地址生成依赖此头）
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }
}
