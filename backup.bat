@echo off
rem ============================================================
rem Daily database backup (invoked by Windows Task Scheduler at 02:00)
rem Usage: backup.bat
rem
rem Credentials (week10 P0-1: no cleartext password is kept in any
rem committed file any more):
rem   1) config\mysql-client.local.cnf  -- passed to mysqldump via
rem      --defaults-extra-file (gitignored, generated by ops locally)
rem   2) fallback: environment variable DB_PASSWORD
rem Neither present -> abort with a clear message (no weak default).
rem
rem NOTE: keep this file ASCII-only. cmd.exe reads .bat in the OEM
rem codepage (936 on this host); UTF-8 Chinese comments can be
rem mis-decoded and break the script.
rem ============================================================

set "MYSQLDUMP=D:\bigplan\tools\mysql-8.0.46\bin\mysqldump.exe"
set "DB=exam_prep"
set "DBUSER=root"
set "DBHOST=127.0.0.1"
set "DIR=%~dp0backup"
set "KEEP=7"
set "CNF=%~dp0config\mysql-client.local.cnf"

rem Option 1: options file (user/host/password all come from the cnf)
rem Option 2: DB_PASSWORD from the environment (user/host passed explicitly,
rem           otherwise mysqldump falls back to the OS account name, e.g. ODBC)
set "AUTH_ARGS="
if exist "%CNF%" (
    set "AUTH_ARGS=--defaults-extra-file=%CNF%"
) else (
    if "%DB_PASSWORD%"=="" goto :no_credentials
    set "MYSQL_PWD=%DB_PASSWORD%"
    set "AUTH_ARGS=-u %DBUSER% -h %DBHOST%"
)

if not exist "%DIR%" mkdir "%DIR%"

for /f "tokens=2 delims==" %%I in ('wmic os get localdatetime /value') do set "DT=%%I"
set "STAMP=%DT:~0,8%"

rem Dump to a .tmp first and rename only on success: a failed run must never
rem destroy a good dump taken earlier the same day (STAMP is date-only).
set "TMPFILE=%DIR%\%DB%_%STAMP%.sql.tmp"
set "OUTFILE=%DIR%\%DB%_%STAMP%.sql"

"%MYSQLDUMP%" %AUTH_ARGS% --databases %DB% > "%TMPFILE%"
set "BACKUP_RC=%ERRORLEVEL%"
set "MYSQL_PWD="

if not "%BACKUP_RC%"=="0" (
    echo [ERROR] mysqldump failed, exit code %BACKUP_RC%
    if exist "%TMPFILE%" del "%TMPFILE%"
    exit /b %BACKUP_RC%
)

rem Guard against "success" with an empty/tiny file (e.g. broken option file)
for %%S in ("%TMPFILE%") do if %%~zS LSS 1024 (
    echo [ERROR] dump file too small, aborted
    del "%TMPFILE%"
    exit /b 3
)

move /y "%TMPFILE%" "%OUTFILE%" >nul

rem keep only the newest %KEEP% dumps
for /f "skip=%KEEP% delims=" %%F in ('dir /b /o-n "%DIR%\%DB%_*.sql"') do del "%DIR%\%%F"

echo Backup done: %DIR%\%DB%_%STAMP%.sql
exit /b 0

:no_credentials
echo [ERROR] No credentials found.
echo         Put config\mysql-client.local.cnf in place, or set DB_PASSWORD.
exit /b 2
