# ============================================================
# 本地开发配置 · 模板
# ------------------------------------------------------------
# 用法：把本文件复制一份，重命名为 application-local.yml，
#       然后把下面的密码改成你本机 MySQL 的真实口令。
#
# 为什么这么做：
#   application-local.yml 已被 .gitignore 排除，不会提交到 Git，
#   所以你的数据库口令不会泄露到仓库里。
# ============================================================

spring:
  datasource:
    username: root
    password: 在这里填你本机 MySQL 的 root 密码

app:
  jwt:
    # 本地开发用。上线前请换成随机长字符串。
    secret: <用 openssl rand -base64 32 生成，勿提交真实值>

  ai:
    # ---------- 向量通道 + 拒答语义闸门（局域网/演示环境开启）----------
    # 关闭时只剩词法闸门：拒答准确率 80%（离线降级基线）；
    # 开启后语义闸门（cosine < 0.62 拒答）生效，拒答准确率 90%。
    # AI 服务未启动时不会误拒：isReady()=false → 自动跳过语义闸门，退回词法判定。
    fastapi:
      enabled: true
    vector:
      enabled: true
