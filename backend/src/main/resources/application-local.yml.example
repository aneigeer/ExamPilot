# ============================================================
# 本地开发配置 · 模板
# ------------------------------------------------------------
# 用法：把本文件复制一份，重命名为 application-local.yml，
#       然后把下面的密码改成你本机 MySQL 的真实口令。
#
# 为什么这么做：
#   application-local.yml 已被 .gitignore 排除，不会提交到 Git，
#   所以你的数据库口令不会泄露到仓库里。
# ============================================================

spring:
  datasource:
    username: root
    password: 在这里填你本机 MySQL 的 root 密码

app:
  jwt:
    # 本地开发用。上线前请换成随机长字符串。
    secret: exam-prep-local-dev-secret-key-0123456789-abcdefghijklmnop
