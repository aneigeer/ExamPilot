# ============================================================
# 大学生多考试备考知识库与题库系统 —— 统一 .gitignore
# 覆盖：Java/Maven、Android/Gradle、Node/Vue 三套技术栈
# ============================================================

# ---------- 工具数据（AI 工作目录，不纳入版本控制）----------
.workbuddy/
.pytest_cache/
.git-backup-before-purge/

# ---------- IDE / 编辑器 ----------
.idea/
*.iml
*.iws
*.ipr
.vscode/
!.vscode/extensions.json

# ---------- Java / Maven / Spring Boot ----------
target/
!.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# ---------- TLS 证书（私钥绝不入库；证书由 scripts/生成自签证书.ps1 生成）----------
nginx/certs/

# ---------- Android / Gradle ----------
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
local.properties
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.ap_
*.dex
*.keystore
!debug.keystore
*.jks
# 发布签名口令（切勿提交）
keystore.properties
# 签名密钥目录（切勿提交）
signing/
release/

# ---------- Node / Vue ----------
node_modules/
dist/
dist-ssr/
.vite/
.npm/
.pnpm-store/
*.local

# ---------- 日志与临时文件 ----------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.bak
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---------- 运行时数据（上传文件、数据库文件）----------
uploads/
*.db
*.sqlite

# ---------- 敏感配置（本地口令不外传）----------
.env
.env.local
application-local.yml
application-local.yaml
application-prod.yml
application-prod.yaml

# 本地临时文件（含本机密钥，切勿提交）
tok.txt
rec.json
.venv-ai/
__pycache__/
*.pyc

# 本地向量库数据（Qdrant 本地目录模式，可由 vectorize_all.py 重建，54MB 不入库）
ai-service/data/

# IDE 与备份目录
.trae/
backup/
