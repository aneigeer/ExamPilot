# ============================================================
# 生产环境 Docker Compose 环境变量模板（.env.prod.example）
# 使用方式：
#   1. 复制为 .env.prod（已被 .gitignore 忽略，切勿提交真实密钥）
#   2. 用 openssl rand -hex 32 生成强随机密钥填入下方必填项
#   3. 启动全栈：docker compose --env-file .env.prod -p examprep up -d --build
# ============================================================

# ---------- 1. 数据库与核心安全密钥（必填） ----------
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
# 生成命令：openssl rand -hex 32
JWT_SECRET=CHANGE_ME_WITH_64_HEX_CHARS_FROM_OPENSSL_RAND_HEX_32
# Java 后端与 Python AI 微服务内部通信令牌（两端必须一致）
AI_INTERNAL_TOKEN=CHANGE_ME_WITH_48_HEX_CHARS_FROM_OPENSSL_RAND_HEX_24

# ---------- 2. 大模型双模配置（Local Ollama 或 Cloud API） ----------
# 可选值：ollama | openai | dashscope | zhipu | auto | extractive
LLM_PROVIDER=ollama
# 云端 API 模式必填（本地 ollama 模式留空即可）
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=30000

# 本地 Ollama 模式（容器通过 host.docker.internal 访问宿主机 Ollama）
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=exam-prep-7b

# ---------- 3. 异步任务队列与可观测性 ----------
AI_JOBS_ENABLED=true
JOB_WORKER_ENABLED=true
EVAL_WORKER_ENABLED=true
WIKI_WORKER_ENABLED=false
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
