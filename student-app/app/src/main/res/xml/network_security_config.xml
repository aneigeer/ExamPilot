<?xml version="1.0" encoding="utf-8"?>
<!--
  网络安全配置 —— 正式（release）构建

  上架安全基线：默认禁止一切明文 HTTP；只对下方明确列出的后端主机放行明文。
  正式部署应整体切到 HTTPS，届时可直接删除下方 domain-config 段，做到「零明文」。

  注意：debug 构建由 src/debug/res/xml/network_security_config.xml 覆盖本文件，
  保持局域网 http 联调可用（见该文件说明）。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <!-- 过渡期：如后端暂以 http 提供服务，在此逐个放行主机（不要把通配放进来）
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">api.example.com</domain>
    </domain-config>
    -->
</network-security-config>
