<?xml version="1.0" encoding="utf-8"?>
<!--
  网络安全配置 —— 正式（release）构建

  上架安全基线：默认禁止一切明文 HTTP；只对下方明确列出的后端主机放行明文。
  正式部署应整体切到 HTTPS，届时可直接删除下方 domain-config 段，做到「零明文」。

  注意：debug 构建由 src/debug/res/xml/network_security_config.xml 覆盖本文件，
  保持局域网 http 联调可用（见该文件说明）。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <!-- 过渡期：后端暂以 http 局域网 IP 提供服务，仅放行开发机当前局域网地址（不要把通配放进来）。
         换网络环境时需与 app/build.gradle 里 release 的 BASE_URL 同步更新；
         正式部署切到 HTTPS 后删除本段，做到「零明文」。 -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.200.73.127</domain>
    </domain-config>
</network-security-config>
