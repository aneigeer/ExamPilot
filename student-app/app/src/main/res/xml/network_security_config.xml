<?xml version="1.0" encoding="utf-8"?>
<!--
  网络安全配置 —— 正式（release）构建

  上架安全基线：默认禁止一切明文 HTTP；只信任下方显式声明的锚点。
  局域网部署用自签证书（nginx 443 终结 TLS），因此额外信任
  res/raw/server_cert.pem —— 由 scripts/生成自签证书.ps1 生成并随包分发。

  ★ 为什么自签必须显式信任：Android 7+ 只信任系统 CA，自签证书不在其中，
    不写 trust-anchors 会直接 SSLHandshakeException（而不是降级明文）。
  ★ 换局域网 IP 后必须重跑证书脚本并重打 APK：证书 SAN 里写死了 IP。
  ★ 正式 CA 证书上线后：删掉 @raw/server_cert 与 domain-config，
    只保留 system 锚点，即回到「零自签信任」。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="@raw/server_cert" />
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- 局域网后端：走 nginx 443，禁止明文；锚点与 base 一致 -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">10.200.83.194</domain>
        <trust-anchors>
            <certificates src="@raw/server_cert" />
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
