<?xml version="1.0" encoding="utf-8"?>
<!--
  AI 面试页
  结构：顶部标题栏 → 开场设置卡（主题 / 题数 / 开始）→ 对话列表 → 底部作答栏 + 进度遮罩
  无障碍：所有可点控件都有 contentDescription，文字全部用 sp（跟随系统字体缩放），
          触控高度 >= 48dp。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="返回上一页"
            android:padding="6dp"
            android:text="← 返回"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="AI 面试"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnRestart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="重新开始一场面试"
            android:padding="6dp"
            android:text="重新开始"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 开场设置：主题 + 题数 + 开始 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSetup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        app:cardBackgroundColor="@color/card"
        app:cardCornerRadius="15dp"
        app:strokeColor="@color/divider"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="模拟面试官会基于站内面试题库出题，逐题评分并给出改进建议。"
                android:textColor="@color/text_sub"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etTopic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:autofillHints=""
                android:contentDescription="面试主题，可留空，留空则随机出题"
                android:hint="面试主题（留空=随机，如 RAG、Java 并发）"
                android:importantForAutofill="no"
                android:inputType="text"
                android:minHeight="48dp"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_sub"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="题数"
                android:textColor="@color/text_sub"
                android:textSize="13sp" />

            <RadioGroup
                android:id="@+id/rgTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="选择面试题数"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbThree"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:contentDescription="3 题"
                    android:minHeight="48dp"
                    android:text="3 题"
                    android:textColor="@color/text_main"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbFive"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:contentDescription="5 题"
                    android:minHeight="48dp"
                    android:text="5 题"
                    android:textColor="@color/text_main"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbEight"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:contentDescription="8 题"
                    android:minHeight="48dp"
                    android:text="8 题"
                    android:textColor="@color/text_main"
                    android:textSize="14sp" />
            </RadioGroup>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:contentDescription="开始面试"
                android:minHeight="48dp"
                android:text="开始面试"
                android:textSize="15sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 对话列表 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChat"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:contentDescription="面试对话区"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:text="设置好主题与题数后点「开始面试」\n面试官会逐题提问、评分并给出追问"
            android:textColor="@color/text_sub"
            android:textSize="14sp" />
    </FrameLayout>

    <!-- 底部作答栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:padding="10dp">

        <EditText
            android:id="@+id/etAnswer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:autofillHints=""
            android:contentDescription="输入你的作答"
            android:enabled="false"
            android:hint="输入你的作答…"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:maxLength="2000"
            android:maxLines="5"
            android:minHeight="48dp"
            android:textColor="@color/text_main"
            android:textColorHint="@color/text_sub"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:contentDescription="提交作答"
            android:enabled="false"
            android:minHeight="48dp"
            android:minWidth="72dp"
            android:text="提交"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- 进度遮罩（请求中不可误触） -->
    <FrameLayout
        android:id="@+id/progressOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@color/card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="22dp">

            <ProgressBar
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/tvProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="面试官正在思考…"
                android:textColor="@color/text_main"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
