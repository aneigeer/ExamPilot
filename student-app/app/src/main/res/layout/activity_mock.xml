<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/primary" android:gravity="center_vertical"
        android:orientation="horizontal" android:padding="14dp">
        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:padding="6dp" android:text="← 返回"
            android:textColor="#FFFFFF" android:textSize="15sp" />
        <TextView
            android:id="@+id/tvMockTitle"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:layout_marginStart="10dp"
            android:text="模拟考试" android:textColor="#FFFFFF" android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/btnMockCard"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginEnd="10dp" android:padding="6dp" android:text="答题卡"
            android:textColor="#FFFFFF" android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/tvTimer"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="#FFD54F" android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <!-- 配置态 -->
            <LinearLayout
                android:id="@+id/llMockConfig"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView style="@style/StatLabel" android:text="科目" />
                <Spinner
                    android:id="@+id/spMockSubject"
                    android:layout_width="match_parent" android:layout_height="44dp"
                    android:background="@android:drawable/editbox_background" />
                <TextView style="@style/StatLabel" android:layout_marginTop="12dp" android:text="题数" />
                <EditText
                    android:id="@+id/etMockCount"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="number" android:text="10"
                    android:background="@android:drawable/editbox_background" android:padding="10dp" />
                <TextView style="@style/StatLabel" android:layout_marginTop="12dp" android:text="时长（分钟）" />
                <EditText
                    android:id="@+id/etMockDuration"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="number" android:text="15"
                    android:background="@android:drawable/editbox_background" android:padding="10dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMockStart"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:layout_marginTop="20dp" android:text="开始考试" />
            </LinearLayout>

            <!-- 答题态 -->
            <LinearLayout
                android:id="@+id/llMockExam"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone">
                <TextView
                    android:id="@+id/tvMockProgress"
                    style="@style/StatLabel" android:text="第 1 / 10 题" />
                <TextView
                    android:id="@+id/tvMockStem"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text_main" android:textSize="16sp"
                    android:lineSpacingExtra="4dp" />
                <LinearLayout
                    android:id="@+id/llMockOptions"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:orientation="vertical" />
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMockPrev"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:layout_marginEnd="6dp"
                        android:text="上一题" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMockNext"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:layout_marginStart="6dp"
                        android:text="下一题" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMockSubmit"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:layout_margin="14dp" android:text="交卷"
        android:visibility="gone" />
</LinearLayout>
