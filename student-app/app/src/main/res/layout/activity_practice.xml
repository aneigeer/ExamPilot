<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">

    <!-- 顶部进度条 -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/primary" android:gravity="center_vertical"
        android:orientation="horizontal" android:padding="14dp">

        <TextView
            android:id="@+id/tvProgress"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="第 1 / 10 题 · 对 0"
            android:textColor="#FFFFFF" android:textSize="15sp" />

        <TextView
            android:id="@+id/btnFinish"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="交卷" android:textColor="#FFFFFF"
            android:background="?attr/selectableItemBackground" android:padding="6dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <TextView
                android:id="@+id/tvTypeName"
                style="@style/StatLabel" android:text="单选题" />

            <TextView
                android:id="@+id/tvStem"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_main" android:textSize="16sp"
                android:lineSpacingExtra="4dp" android:text="加载中…" />

            <TextView
                android:id="@+id/tvMaterial"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@color/card" android:padding="10dp"
                android:textColor="@color/text_sub" android:textSize="13sp"
                android:visibility="gone" />

            <!-- 答题区（动态注入：选项按钮 / 输入框 / 子题） -->
            <LinearLayout
                android:id="@+id/llAnswerArea"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:orientation="vertical" />

            <!-- 判分结果区 -->
            <LinearLayout
                android:id="@+id/llResult"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvJudge"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="15sp" android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCorrectAnswer"
                    style="@style/CardText" android:layout_marginTop="6dp" />

                <TextView
                    android:id="@+id/tvAnalysis"
                    style="@style/CardText" android:layout_marginTop="6dp" />

                <TextView
                    android:id="@+id/tvSelfEvalTip"
                    style="@style/StatLabel" android:layout_marginTop="10dp"
                    android:text="这道题你会了吗？" android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/llSelfEval"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:orientation="horizontal"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEvalKnow"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:layout_marginEnd="4dp"
                        android:text="会了" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEvalUnsure"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_marginStart="4dp" android:layout_marginEnd="4dp"
                        android:layout_height="wrap_content"
                        android:text="模糊" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEvalDont"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:layout_height="wrap_content"
                        android:text="不会" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAction"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:layout_margin="14dp" android:text="提交答案" />
</LinearLayout>
