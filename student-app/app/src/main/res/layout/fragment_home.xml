<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">

<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    android:id="@+id/refresh"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <TextView
        android:id="@+id/btnSearch"
        android:layout_width="match_parent" android:layout_height="44dp"
        android:layout_margin="14dp" android:gravity="center_vertical"
        android:paddingStart="14dp" android:paddingEnd="14dp"
        android:background="@android:drawable/editbox_background"
        android:text="🔍 搜索资料…" android:textColor="@color/text_sub" android:textSize="14sp" />

    <ScrollView
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="14dp">

            <!-- 平台统计 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:padding="14dp">
                    <LinearLayout style="@style/StatCol">
                        <TextView android:id="@+id/tvStatSubject" style="@style/StatNum" android:text="0" />
                        <TextView style="@style/StatLabel" android:text="科目" />
                    </LinearLayout>
                    <LinearLayout style="@style/StatCol">
                        <TextView android:id="@+id/tvStatQuestion" style="@style/StatNum" android:text="0" />
                        <TextView style="@style/StatLabel" android:text="题目" />
                    </LinearLayout>
                    <LinearLayout style="@style/StatCol">
                        <TextView android:id="@+id/tvStatResource" style="@style/StatNum" android:text="0" />
                        <TextView style="@style/StatLabel" android:text="资料" />
                    </LinearLayout>
                    <LinearLayout style="@style/StatCol">
                        <TextView android:id="@+id/tvStatUser" style="@style/StatNum" android:text="0" />
                        <TextView style="@style/StatLabel" android:text="用户" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 刷题入口 -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStartPractice"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="52dp" android:layout_marginEnd="6dp"
                    android:text="开始刷题" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStartMock"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="52dp" android:layout_marginStart="6dp"
                    android:text="模拟考试" />
            </LinearLayout>

            <!-- 公告 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="14dp">
                    <TextView style="@style/CardTitle" android:text="📢 平台公告" />
                    <TextView
                        android:id="@+id/tvAnnouncements"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/text_sub" android:textSize="13sp"
                        android:lineSpacingExtra="4dp" android:text="加载中…" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 考试类别 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="14dp">
                    <TextView style="@style/CardTitle" android:text="📚 考试类别" />
                    <TextView
                        android:id="@+id/tvExams"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/text_sub" android:textSize="13sp"
                        android:lineSpacingExtra="4dp" android:text="加载中…" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 热门资料 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="14dp">
                    <TextView style="@style/CardTitle" android:text="🔥 热门资料" />
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvHotResources"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

<com.google.android.material.floatingactionbutton.FloatingActionButton
    android:id="@+id/fabUpload"
    android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:layout_gravity="bottom|end" android:layout_margin="18dp"
    android:src="@drawable/ic_fab_add" android:contentDescription="上传资料"
    app:tint="#FFFFFF" xmlns:app="http://schemas.android.com/apk/res-auto" />
</FrameLayout>
