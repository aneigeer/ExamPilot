# ======================================================================================
# AI 微服务专用 .gitignore
#
# 核心目的：**模型文件不进 Git**。
# bge-small-zh-v1.5 的 ONNX INT8 约 28MB，放进仓库会让 clone 变慢、
# 且模型有独立版本管理（HF 版本号），与代码版本管理解耦更合理。
#
# ★ 提交前请确认模型文件确实没被 add 进暂存区：
#     git status --short ai-service\models\
# ======================================================================================

# ---- 模型文件（体积大，不提交）----
models/
!models/.gitkeep
!models/README.md

# ---- 环境变量（含密钥，绝对不能提交）----
.env
.env.local
.env.*.local

# ---- Python 缓存 ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib60/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ---- pytest / 测试产物 ----
.pytest_cache/
.cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.hypothesis/
.tox/

# ---- 虚拟环境（本项目建在项目根的 .venv-ai，此处兜底）----
.venv/
.venv-ai/
venv/
env/
ENV/

# ---- 类型检查 / lint 缓存 ----
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pyre/
.pytype/

# ---- OCR 临时文件 ----
ocr_tmp/
*.ocr.json

# ---- 编辑器 ----
.idea/
.vscode/
*.swp
*.swo
*~

# ---- 日志 ----
*.log
logs/
