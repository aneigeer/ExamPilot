# ======================================================================================
# AI 微服务环境变量样例
#
# 用法：复制为 .env 后按需修改
#   Windows CMD ：copy .env.example .env
#   PowerShell  ：Copy-Item .env.example .env
#
# ★ 所有变量都有默认值，.env 可以完全为空，服务照样能起
#   （只是相应能力标记为 ready=false，接口返回 503，Java 侧自动降级）
#
# ★ 真实密钥请勿提交到 Git（.gitignore 已排除 .env）
# ======================================================================================


# ---------------------- 服务基础 ----------------------
# 服务名与版本（出现在 /v1/health 与日志里）
APP_NAME=examprep-ai-service
APP_VERSION=1.0.0

# 监听地址与端口（Java 侧 application.yml 里的 app.ai.fastapi.base-url 要对应）
HOST=127.0.0.1
PORT=8000

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 跨域来源，逗号分隔；本机使用用 * 即可
CORS_ORIGINS=*


# ---------------------- Embedding ----------------------
# 模型根目录（每个模型一个子目录，如 models\bge-small-zh-v1.5\）
MODELS_DIR=models

# 模型标识。★ 换模型必须全量重建 Qdrant 索引，否则检索结果彻底错乱
EMBEDDING_MODEL_ID=bge-small-zh-v1.5

# 模型文件名（放在 MODELS_DIR\EMBEDDING_MODEL_ID\ 下）
EMBEDDING_ONNX_FILE=model.onnx
EMBEDDING_TOKENIZER_FILE=tokenizer.json

# 向量维度。bge-small-zh-v1.5 = 512；换模型必须同步改 Qdrant collection 维度
EMBEDDING_DIM=512

# 分词最大长度。本项目语料是 400 字内短文本，512 足够
EMBEDDING_MAX_LENGTH=512

# 单次批量推理条数
EMBEDDING_BATCH_SIZE=8

# ONNX 推理线程数，0 = 由 onnxruntime 自行决定（本机 32 核一般不用改）
EMBEDDING_INTRA_OP_THREADS=0

# bge 官方推荐的检索问句前缀，改了会影响召回质量，不建议动
EMBEDDING_QUERY_INSTRUCTION=为这个句子生成表示以用于检索相关文章：

# 模型缺失时是否自动从 HuggingFace 下载。
# ★ 默认关闭：使用场景可能断网，且下载体积需主理人确认。
#   打开需要额外安装 huggingface-hub。
EMBEDDING_AUTO_DOWNLOAD=false


# ---------------------- Qdrant 向量库 ----------------------
# 地址由 docker-compose.ai.yml 暴露的端口决定
QDRANT_URL=http://127.0.0.1:6333

# 集合名，必须与 Java 侧 ai_vector_index_meta.collection 一致
QDRANT_COLLECTION=exam_chunks

# API Key。留空 = 不鉴权（仅本机使用）；对外暴露时必须设置
QDRANT_API_KEY=

# 维度（与 EMBEDDING_DIM 保持一致）
QDRANT_DIM=512

# 连接与读超时（秒）。Java 侧给 FastAPI 的预算是 1200ms，这里留余量
QDRANT_TIMEOUT_SECONDS=5.0

# 是否走 gRPC（6334 端口）。本项目用 HTTP 即可
QDRANT_PREFER_GRPC=false


# ---------------------- 大模型（GLM）----------------------
# ★ 留空 = 未配置，/v1/llm 返回 503，Java 侧走抽取式兜底，App 侧仍是 200。
#   这是**安全默认值**：不配 Key 也能完整使用问答功能，不误扣费。
LLM_API_KEY=

# OpenAI 兼容端点（智谱 GLM）
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 模型名。glm-4-flash 有免费额度，适合功能验证
LLM_MODEL=glm-4-flash

# 采样温度（低温度 = 更稳，不易编造）
LLM_TEMPERATURE=0.3

# 最大生成 token 数
LLM_MAX_TOKENS=1500

# 上游超时（秒）。Java 侧预算 8000ms
LLM_TIMEOUT_SECONDS=30.0

# 生成器标识，写入响应 generator 字段，便于 Java 侧区分
LLM_GENERATOR_NAME=glm


# ---------------------- OCR（PaddleOCR）----------------------
# 总开关。false 时 /v1/ocr 直接 503（连 import 都不做）
OCR_ENABLED=true

# 识别语言
OCR_LANG=ch

# 离线模型目录。留空则用 PaddleOCR 默认缓存（%USERPROFILE%\.paddlex\official_models）
# 离线部署时把缓存目录复制过来，并填到这里
OCR_MODEL_DIR=models/paddle

# 是否启用方向分类器（试卷拍照可能倾斜）。会增加约 10MB 模型与一点耗时
OCR_USE_ANGLE_CLS=false

# 丢弃低于该置信度的识别文本（避免脏数据进草稿）
OCR_DROP_SCORE=0.3

# OCR 超时（秒）。PaddleOCR 首次加载模型约 5-15 秒，单页识别 1-3 秒
OCR_TIMEOUT_SECONDS=60.0

# 题干置信度低于此值 → Java 侧判为"需人工重录"，不入库（G1 兜底）
OCR_STEM_CONFIDENCE_THRESHOLD=0.75

# 字段置信度低于此值 → Java 侧留空并高亮，强制人工补全（G1 兜底）
OCR_FIELD_CONFIDENCE_THRESHOLD=0.90


# ---------------------- Agent Harness ----------------------
# Agent 路由开关（Java 侧另有 app.ai.agent.enabled 总开关）
AGENT_ENABLED=true

# Java 后端地址（含 context-path /api）；工具数据与 LLM 代理都走这里
JAVA_BASE_URL=http://127.0.0.1:8080/api

# ★ 内部接口令牌：必须与 Java 的 app.ai.internal-token（--app.ai.internal-token）完全同值
#   —— 留空时：
#     * Java → Python 的 /internal/** 一律 403（Java 侧 fail-closed）
#     * Python 的 /v1/agent/* 一律 401（本服务 fail-closed）
#   即"Agent 工具链整体不可用"，但 AI 问答（/v1/ask、/v1/search 等）不受影响。
#   ★ 这里不要写任何真实令牌，真实值只放 .env（已被 .gitignore 排除）。
AI_INTERNAL_TOKEN=

# 是否放行匿名访问 /v1/agent/*（关闭鉴权的逃生舱，**仅限本地开发**，默认必须为 0）。
#   =1 时启动会打一条 ERROR 日志，且每次匿名放行都记 WARNING；
#   生产环境没有任何理由打开它 —— 打开等于把"按 userId 查私有学情"的接口暴露给本机任意进程。
AGENT_ALLOW_ANONYMOUS=0

# 单次会话最大步数与工具调用次数
AGENT_MAX_STEPS=6
AGENT_MAX_TOOL_CALLS=4

# prompt 字符预算（≈8k tokens），超出后从最老的工具结果开始截断
AGENT_MAX_PROMPT_CHARS=8000

# 单次工具 / LLM 调用超时（秒）
AGENT_TOOL_TIMEOUT_SECONDS=10.0
AGENT_LLM_TIMEOUT_SECONDS=30.0

# ---------------------- Subagent 受控实验（默认关）---------------------
# =true 才走"拆解 → 逐个子问题 → 汇总"；=false（默认）时执行路径、SSE 事件序列、
# 延迟与单 Agent 完全一致（不会多一次 LLM 调用，也不会多一个事件）。
# ★ 收益评审结论是**保持关闭**（见 README「Subagent 受控实验」小节：
#   规则模式 120 条任务通过率 0 提升且 100% 在拆解处降级；
#   模型模拟组步数 2.25→4.50、120/120 步数超限）。
AGENT_SUBAGENT_ENABLED=false
# 拆解出的子问题个数上限（硬上限 3，越界启动时 clamp + WARNING）。
# 子问题共享同一份会话级工具预算(4 次)与步数预算(6 步)，不是每个子问题各一份。
AGENT_SUBAGENT_MAX_QUESTIONS=3


# ---------------------- 异步任务队列（Redis Stream）---------------------
# 业务任务消费者开关（与评估消费者分开，避免长任务互相阻塞）
JOB_WORKER_ENABLED=false

# 评估任务消费者开关
EVAL_WORKER_ENABLED=false

# Redis 地址（未启动时 worker 只告警，不影响 FastAPI 其余接口）
REDIS_URL=redis://127.0.0.1:6379/0

# 三条独立 stream（业务 / 评估 / Wiki 蒸馏，各自独立 worker 与连接池）
JOB_STREAM=exam:jobs
EVAL_STREAM=exam:eval
WIKI_STREAM=exam:wiki

# 消费者组名（三个 worker 共用组名，但各自的 stream 不同）
JOB_GROUP=expert-workers

# 消费者名，留空 = hostname-pid（避免多进程同名）
JOB_CONSUMER=

# XREADGROUP 阻塞毫秒 / pending 超时判定 / claim+trim 周期
JOB_BLOCK_MS=5000
JOB_CLAIM_IDLE_MS=60000
JOB_TRIM_INTERVAL_MS=60000


# ---------------------- LLM Wiki 双引擎 ----------------------
# Wiki 页面摘要向量集合（与 RAG 的 exam_chunks 分开，互不影响）
WIKI_ENABLED=true
WIKI_COLLECTION=wiki_pages

# Wiki 蒸馏消费者开关（分钟级 LLM 长任务，必须与业务/评估 worker 分开）
WIKI_WORKER_ENABLED=false

# 单次最多蒸馏页数 / 单页正文字符上限（防止本地小模型跑一整夜或输出失控）
WIKI_DISTILL_MAX_PAGES=20
WIKI_DISTILL_MAX_CHARS=4000

# 数据库口令（必填；脚本与 AI 服务从这里/环境变量读取，代码中不保存明文）
DB_PASSWORD=
